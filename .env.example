NEXT_PUBLIC_AMAP_JS_KEY=
# Backward compatibility for older code paths (optional)
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

# Server-side only. Used by /api/weather and planner weather context.
AMAP_WEB_SERVICE_KEY=

# Optional: used by scripts/fetch-pexels-images.ts only.
# Missing key will degrade gracefully and keep existing image map.
PEXELS_API_KEY=

# Optional: Qwen planner decision layer (server-side only)
# If missing, planner automatically degrades to rule-based fallback.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# Optional: Coze API search integration (server-side only)
# If missing, Coze search falls back to local mock data.
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_USER_ID=
COZE_API_URL=
