# Beijing MVP: AMap browser SDK keys. NEXT_PUBLIC_* values are exposed to the client.
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

# Server-side only. Used by /api/weather and planner weather context.
AMAP_WEB_SERVICE_KEY=

# Future Supabase integration. Do not expose SUPABASE_SERVICE_ROLE_KEY to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek planner decision layer. Server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional: used by scripts/fetch-pexels-images.ts only.
# Missing key will degrade gracefully and keep existing image map.
PEXELS_API_KEY=
