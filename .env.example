NEXT_PUBLIC_AMAP_JS_KEY=your_amap_js_key
# Backward compatibility for older code paths (optional)
NEXT_PUBLIC_AMAP_KEY=your_amap_js_key
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=your_amap_security_js_code
AMAP_WEB_SERVICE_KEY=your_amap_webservice_key

# Optional: used by scripts/fetch-pexels-images.ts only.
# Missing key will degrade gracefully and keep existing image map.
PEXELS_API_KEY=your_pexels_api_key

# Optional: Qwen planner decision layer (server-side only)
# If missing, planner automatically degrades to rule-based fallback.
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
